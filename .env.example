APP_NAME=MiseLedger
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002
APP_PORT=8002
VITE_PORT=5174

WWWGROUP=1000
WWWUSER=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=miseledger
DB_USERNAME=miseledger
DB_PASSWORD=miseledger

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Subscription plan catalog contract (docs/subscription-plan-catalog.md).
# Values remain application-owned and independent from payment-provider
# selection.
SUBSCRIPTION_TYPE=default
SUBSCRIPTION_BILLING_CURRENCY=
SUBSCRIPTION_TRIAL_DAYS=

# Billing acquisition-provider contract.
# Production must explicitly select stripe or paymongo. There is intentionally
# no implicit provider fallback.
BILLING_PROVIDER=
BILLING_STRIPE_ENABLED=false
BILLING_PAYMONGO_ENABLED=false

# Stripe provider configuration.
# Real credentials must never be committed.
STRIPE_KEY=
STRIPE_SECRET=
# Set both API keys to the same Stripe mode. Production resolves only the live
# webhook secret while test environments resolve only the test secret.
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_WEBHOOK_SECRET=

# PayMongo provider configuration.
# Use pk_test_/sk_test_ for sandbox and pk_live_/sk_live_ for production.
# PAYMONGO_WEBHOOK_SECRET is the whsk_ secret assigned to the configured
# webhook endpoint. Real values must never be committed.
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_MODE=
PAYMONGO_API_BASE_URL=https://api.paymongo.com/v1

# Provider plan identifiers belong only in server-side configuration. Add a
# pair for every configured internal plan code; leave unsupported intervals blank.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
PAYMONGO_PLAN_STARTER_MONTHLY=
PAYMONGO_PLAN_STARTER_YEARLY=

BILLING_LOG_CHANNEL=stack
