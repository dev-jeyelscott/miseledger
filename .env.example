APP_NAME=MiseLedger
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002
APP_PORT=8002
VITE_PORT=5174

WWWGROUP=1000
WWWUSER=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=miseledger
DB_USERNAME=miseledger
DB_PASSWORD=miseledger

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Subscription plan catalog contract (docs/subscription-plan-catalog.md).
# Values are intentionally unset: currency, trial length, and Stripe Price
# IDs are unresolved business decisions and must not be guessed here.
SUBSCRIPTION_TYPE=default
SUBSCRIPTION_BILLING_CURRENCY=
SUBSCRIPTION_TRIAL_DAYS=

# Billing configuration contract (config/billing.php). Stripe credentials
# are intentionally unset placeholders; never commit real values here.
STRIPE_KEY=
STRIPE_SECRET=
# Set both keys to the same Stripe mode. Production uses only the live
# webhook secret; local and test deployments use only the test secret.
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_WEBHOOK_SECRET=
BILLING_LOG_CHANNEL=stack
